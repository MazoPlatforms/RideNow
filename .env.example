NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://ride:ride@localhost:5432/ride
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-64-hex-characters
OTP_PEPPER=replace-with-another-32-random-characters
CORS_ORIGINS=http://localhost:5173
OTP_PROVIDER=database
MAP_GRAPH_PATH=data/kattankudy-routing.json
MAP_MANIFEST_PATH=data/kattankudy-routing-manifest.json
MAP_CATEGORY_APPROVALS=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ride-documents
S3_ACCESS_KEY=ride-local
S3_SECRET_KEY=ride-local-password
FCM_ENABLED=false
# Required in production for the administrator sign-in human check.
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=
# Development OTPs are available ONLY from the development-deliveries CLI.
# Production requires OTP_PROVIDER=baileys and MAP_CATEGORY_APPROVALS=TUK,CAR,VAN

# Optional: browser-reachable signing endpoint when backend uses an internal S3 endpoint
# S3_PUBLIC_ENDPOINT=http://localhost:9000
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
TRUST_PROXY_HOPS=0

# Optional one-time import of paired Baileys creds.json (prefer a secret manager)
# WA_AUTH_CREDS=<raw JSON; do not commit credentials>

# R2 endpoints automatically use verified immutable copies; other S3 uses versioning.
# S3_OBJECT_MODE=immutable

# Supabase defaults: DB_SCHEMA=ridenow and DB_ROLE=ridenow_backend.
# Local PostgreSQL defaults to public without a role switch.
# Optional pool limit per process; start:pilot defaults to 4 (minimum 2).
# DB_POOL_MAX=4

# Temporary first-admin web setup. Disabled unless both values are supplied.
# ADMIN_SETUP_KEY=<at least 32 random characters; never commit>
# ADMIN_SETUP_EXPIRES_AT=<UTC ISO timestamp>
