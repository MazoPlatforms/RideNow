    <string name="q_go_online">"நான் எப்படி ஆன்லைனில் செல்வது?"</string>
    <string name="a_go_online">"முகப்பைத் திறந்து ஆன்லைனில் செல் என்பதைத் தட்டவும். கோரிக்கைகளைப் பெற, அங்கீகரிக்கப்பட்ட கணக்கு மற்றும் சேமித்த வங்கிக் கணக்கு தேவை."</string>
    <string name="q_accept">"சவாரி செய்வதை நான் எப்படி ஏற்றுக்கொள்வது?"</string>
    <string name="a_accept">"கோரிக்கை வரும்போது, ​​பிக்-அப், டிராப் மற்றும் கட்டணத்தைச் சரிபார்த்து, டைமர் முடிவதற்குள் ஏற்றுக்கொள் என்பதைத் தட்டவும்."</string>
    <string name="q_first">"எனது முதல் பயணத்தில் என்ன நடக்கிறது?"</string>
    <string name="a_first">"பிக்அப்பிற்கான வழியைப் பின்தொடரவும், வந்தவை என்பதைத் தட்டவும், ரைடர் ஏறியவுடன் பயணத்தைத் தொடங்கவும், இறக்கும் நேரத்தில் அதை முடிக்கவும்."</string>
    <string name="q_docs">"எனக்கு என்ன ஆவணங்கள் தேவை?"</string>
    <string name="a_docs">"ஓட்டுநர் உரிமம், வாகனப் பதிவு, காப்பீட்டுச் சான்றிதழ், உமிழ்வு சோதனைச் சான்றிதழ் மற்றும் உங்கள் வாகனத்தின் புகைப்படங்கள்."</string>
    <string name="q_expiry">"ஒரு ஆவணம் காலாவதியானால் என்ன செய்வது?"</string>
    <string name="a_expiry">"காலாவதி தேதிக்கு முன் வாகன ஆவணங்களிலிருந்து புதிய நகலை பதிவேற்றவும். காலாவதியான ஆவணங்கள் ஆன்லைனில் செல்வதைத் தடுக்கலாம்."</string>
    <string name="q_change_vehicle">"எனது வாகனத்தை எப்படி மாற்றுவது?"</string>
    <string name="a_change_vehicle">"வாகன விவரங்களைத் திறந்து, வாகன விவரங்களைப் புதுப்பி என்பதைத் தட்டி, புதிய ஆவணங்களைப் பதிவேற்றவும். மாற்றங்கள் பொருந்தும் முன் அவற்றை மதிப்பாய்வு செய்கிறோம்."</string>
    <string name="q_withdraw">"எனது வருமானத்தை எப்படி திரும்பப் பெறுவது?"</string>
    <string name="a_withdraw">"பணம் செலுத்துதல் &amp; பரிவர்த்தனைகளைத் திறந்து, திரும்பப் பெறு என்பதைத் தட்டவும், உங்கள் இருப்புக்கான தொகையை உள்ளிட்டு உறுதிப்படுத்தவும். உங்கள் இணைக்கப்பட்ட வங்கிக் கணக்கிற்கு நிதிகள் செல்லும்."</string>
    <string name="q_payout_late">"எனது கொடுப்பனவு வரவில்லை"</string>
    <string name="a_payout_late">"பணம் செலுத்துவதற்கு மூன்று வேலை நாட்கள் வரை ஆகலாம். அதற்குப் பிந்தையதாக இருந்தால், ஆதரவு டிக்கெட்டை உருவாக்கி, உங்கள் வருமானத்தின் ஸ்கிரீன்ஷாட்டைச் சேர்க்கவும்."</string>
    <string name="q_cash">"பண சவாரிகள் எவ்வாறு கணக்கிடப்படுகின்றன?"</string>
    <string name="a_cash">"நீங்கள் சவாரி செய்பவரிடமிருந்து பணத்தை சேகரிக்கிறீர்கள். இது ரொக்கம் சேகரிக்கப்பட்டதாக பதிவு செய்யப்பட்டுள்ளது மற்றும் உங்கள் திரும்பப் பெறக்கூடிய இருப்பை மாற்றாது."</string>
    <string name="q_cancel">"நான் ஒரு பயணத்தை ரத்து செய்யலாமா?"</string>
    <string name="a_cancel">"ஆம், பயணம் தொடங்கும் முன். அடிக்கடி ரத்து செய்வது உங்கள் மதிப்பீட்டைப் பாதிக்கலாம், எனவே உங்களுக்குத் தேவைப்படும்போது மட்டுமே ரத்துசெய்யவும்."</string>
    <string name="q_nav">"வழிசெலுத்தல் வேலை செய்யவில்லை"</string>
    <string name="a_nav">"RideNow Driver க்கு இருப்பிடம் அனுமதிக்கப்பட்டுள்ளதா என்பதையும், உங்களிடம் தரவு இணைப்பு உள்ளதா என்பதையும் சரிபார்த்து, மீண்டும் செல்லவும்."</string>
    <string name="q_wrong_pin">"பிக்கப் முள் தவறாகத் தெரிகிறது"</string>
    <string name="a_wrong_pin">"ரைடர் எங்கிருக்கிறார்கள் என்பதை உறுதிப்படுத்த அவரை அழைக்கவும் அல்லது மெசேஜ் செய்யவும், மேலும் சவாரிக்குப் பிறகு சிக்கலைப் புகாரளிக்கவும், இதன் மூலம் வரைபடத்தை மேம்படுத்தலாம்."</string>
    <string name="q_edit_profile">"எனது சுயவிவரத்தை எவ்வாறு திருத்துவது?"</string>
    <string name="a_edit_profile">"மேலே உள்ள அவதாரத்திலிருந்து உங்கள் சுயவிவரத்தைத் திறந்து, தனிப்பட்ட தகவலுக்கு அடுத்துள்ள திருத்து என்பதைத் தட்டவும்."</string>
    <string name="q_verify">"சரிபார்ப்புக்கு எவ்வளவு நேரம் ஆகும்?"</string>
    <string name="a_verify">"பெரும்பாலான கணக்குகள் இரண்டு வேலை நாட்களுக்குள் மதிப்பாய்வு செய்யப்படும். அது முடிந்ததும் அறிவிப்பைப் பெறுவீர்கள்."</string>
    <string name="q_phone">"எனது தொலைபேசி எண்ணை மாற்ற முடியுமா?"</string>
    <string name="a_phone">"உங்கள் ஃபோன் எண் சரிபார்க்கப்பட்டது, எனவே அதை மாற்ற புதிய சரிபார்ப்பு தேவை. தொடங்குவதற்கு ஆதரவைத் தொடர்பு கொள்ளவும்."</string>
    <string name="q_emergency">"அவசரகாலத்தில் நான் என்ன செய்ய வேண்டும்?"</string>
    <string name="a_emergency">"உதவி &amp; பாதுகாப்பைத் திறந்து, பின்னர் அவசர உதவியைத் திறந்து, அவசர எண்ணை அழைக்கவும். உங்களால் முடிந்தால் முதலில் பாதுகாப்பான இடத்திற்கு செல்லுங்கள்."</string>
    <string name="q_report">"பாதுகாப்பற்ற நடத்தை பற்றி நான் எவ்வாறு புகாரளிப்பது?"</string>
    <string name="a_report">"உதவி &amp; பாதுகாப்பில் பாதுகாப்புச் சிக்கலைப் புகாரளிக்கவும். உங்களால் முடிந்தவரை விவரங்களைச் சேர்க்கவும், எங்கள் குழு அதை மதிப்பாய்வு செய்யும்."</string>
    <string name="q_share">"எனது பயணத்தை யாரிடமாவது பகிர்ந்து கொள்ளலாமா?"</string>
    <string name="a_share">"ஆம். குடும்பம் அல்லது நண்பர்களுக்கு செய்தி அனுப்ப, உதவி &amp; பாதுகாப்பைத் திறந்து, நேரலைப் பயணத்தைப் பகிர் என்பதைத் தட்டவும்."</string>
