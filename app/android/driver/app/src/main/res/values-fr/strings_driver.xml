    <string name="a_first">"Suivez l\'itinéraire jusqu\'au point de prise en charge, appuyez sur Arrivé, commencez le voyage lorsque le passager monte à bord et terminez-le au dépôt."</string>
    <string name="q_docs">"De quels documents ai-je besoin ?"</string>
    <string name="a_docs">"Un permis de conduire, l\'immatriculation du véhicule, un certificat d\'assurance, un certificat de contrôle des émissions et des photos de votre véhicule."</string>
    <string name="q_expiry">"Que faire si un document expire ?"</string>
    <string name="a_expiry">"Téléchargez une nouvelle copie des documents du véhicule avant la date d\'expiration. Les documents expirés peuvent vous empêcher d’accéder à Internet."</string>
    <string name="q_change_vehicle">"Comment changer de véhicule ?"</string>
    <string name="a_change_vehicle">"Ouvrez les détails du véhicule, appuyez sur Mettre à jour les détails du véhicule et téléchargez de nouveaux documents. Nous examinons les modifications avant qu’elles ne s’appliquent."</string>
    <string name="q_withdraw">"Comment retirer mes gains ?"</string>
    <string name="a_withdraw">"Ouvrez Paiements et transactions, appuyez sur Retirer, saisissez un montant correspondant à votre solde et confirmez. Les fonds vont sur votre compte bancaire lié."</string>
    <string name="q_payout_late">"Mon paiement n\'est pas arrivé"</string>
    <string name="a_payout_late">"Les paiements peuvent prendre jusqu\'à trois jours ouvrables. Si c\'est plus tard, créez un ticket d\'assistance et incluez une capture d\'écran de vos revenus."</string>
    <string name="q_cash">"Comment les courses en espèces sont-elles comptées ?"</string>
    <string name="a_cash">"Vous récupérez de l\'argent auprès du coureur. Il est enregistré comme espèces encaissées et ne modifie pas votre solde retirable."</string>
    <string name="q_cancel">"Puis-je annuler un trajet ?"</string>
    <string name="a_cancel">"Oui, avant le début du voyage. Des annulations fréquentes peuvent affecter votre note, alors n\'annulez que lorsque cela est nécessaire."</string>
    <string name="q_nav">"La navigation ne fonctionne pas"</string>
    <string name="a_nav">"Vérifiez que l\'emplacement est autorisé pour RideNow Driver et que vous disposez d\'une connexion de données, puis réessayez Naviguer."</string>
    <string name="q_wrong_pin">"La broche du micro semble incorrecte"</string>
    <string name="a_wrong_pin">"Appelez ou envoyez un message au passager pour confirmer où il se trouve et signalez le problème après le trajet afin que nous puissions améliorer la carte."</string>
    <string name="q_edit_profile">"Comment modifier mon profil ?"</string>
    <string name="a_edit_profile">"Ouvrez votre profil à partir de l\'avatar en haut, puis appuyez sur Modifier à côté d\'Informations personnelles."</string>
    <string name="q_verify">"Combien de temps prend la vérification ?"</string>
    <string name="a_verify">"La plupart des comptes sont examinés dans un délai de deux jours ouvrables. Vous recevrez une notification lorsque cela sera fait."</string>
    <string name="q_phone">"Puis-je changer mon numéro de téléphone ?"</string>
    <string name="a_phone">"Votre numéro de téléphone est vérifié, sa modification nécessite donc une nouvelle vérification. Contactez le support pour commencer."</string>
    <string name="q_emergency">"Que dois-je faire en cas d\'urgence ?"</string>
    <string name="a_emergency">"Ouvrez Aide et sécurité, puis Assistance d\'urgence et appelez le numéro d\'urgence. Déplacez-vous d’abord dans un endroit sûr si vous le pouvez."</string>
    <string name="q_report">"Comment signaler un comportement dangereux ?"</string>
    <string name="a_report">"Utilisez Signaler un problème de sécurité dans Aide et sécurité. Ajoutez autant de détails que possible et notre équipe les examinera."</string>
    <string name="q_share">"Puis-je partager mon voyage avec quelqu\'un ?"</string>
    <string name="a_share">"Oui. Ouvrez Aide et sécurité et appuyez sur Partager un voyage en direct pour envoyer un message à votre famille ou à vos amis."</string>
