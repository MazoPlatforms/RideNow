    <string name="q_cash">"كيف يتم احتساب الرحلات النقدية؟"</string>
    <string name="a_cash">"تقوم بجمع النقود من الراكب. يتم تسجيلها على أنها نقدية محصلة ولا تغير رصيدك القابل للسحب."</string>
