    <string name="q_expiry">"ماذا لو انتهت صلاحية الوثيقة؟"</string>
    <string name="a_expiry">"قم بتحميل نسخة جديدة من مستندات المركبة قبل تاريخ انتهاء الصلاحية. يمكن أن تمنعك المستندات منتهية الصلاحية من الاتصال بالإنترنت."</string>
    <string name="q_change_vehicle">"كيف يمكنني تغيير سيارتي؟"</string>
    <string name="a_change_vehicle">"افتح تفاصيل المركبة، وانقر فوق تحديث تفاصيل المركبة، وقم بتحميل مستندات جديدة. نحن نراجع التغييرات قبل تطبيقها."</string>
    <string name="q_withdraw">"كيف يمكنني سحب أرباحي؟"</string>
