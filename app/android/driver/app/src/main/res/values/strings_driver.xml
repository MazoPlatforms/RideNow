    <string name="sc_still_help">Still need help? Contact Support</string>
    <string name="q_go_online">How do I go online?</string>
    <string name="a_go_online">Open Home and tap Go Online. You need an approved account and a saved bank account to start receiving requests.</string>
    <string name="q_accept">How do I accept a ride?</string>
    <string name="a_accept">When a request arrives, check the pickup, drop and fare, then tap Accept before the timer ends.</string>
    <string name="q_first">What happens on my first ride?</string>
    <string name="a_first">Follow the route to the pickup, tap Arrived, start the trip when the rider boards, and complete it at drop-off.</string>
    <string name="q_docs">Which documents do I need?</string>
    <string name="a_docs">A driving license, vehicle registration, insurance certificate, emission test certificate and photos of your vehicle.</string>
    <string name="q_expiry">What if a document expires?</string>
    <string name="a_expiry">Upload a new copy from Vehicle Documents before the expiry date. Expired documents can stop you from going online.</string>
    <string name="q_change_vehicle">How do I change my vehicle?</string>
    <string name="a_change_vehicle">Open Vehicle Details, tap Update Vehicle Details, and upload new documents. We review changes before they apply.</string>
    <string name="q_withdraw">How do I withdraw my earnings?</string>
    <string name="a_withdraw">Open Payouts &amp; Transactions, tap Withdraw, enter an amount up to your balance and confirm. Funds go to your linked bank account.</string>
    <string name="q_payout_late">My payout has not arrived</string>
    <string name="a_payout_late">Payouts can take up to three working days. If it is later than that, create a support ticket and include a screenshot of your earnings.</string>
    <string name="q_cash">How are cash rides counted?</string>
    <string name="a_cash">You collect cash from the rider. It is recorded as Cash Collected and does not change your withdrawable balance.</string>
    <string name="q_cancel">Can I cancel a ride?</string>
    <string name="a_cancel">Yes, before the trip starts. Frequent cancellations can affect your rating, so only cancel when you have to.</string>
    <string name="q_nav">Navigation is not working</string>
    <string name="a_nav">Check that location is allowed for RideNow Driver and that you have a data connection, then try Navigate again.</string>
    <string name="q_wrong_pin">The pickup pin looks wrong</string>
    <string name="a_wrong_pin">Call or message the rider to confirm where they are, and report the issue after the ride so we can improve the map.</string>
    <string name="q_edit_profile">How do I edit my profile?</string>
    <string name="a_edit_profile">Open your profile from the avatar at the top, then tap Edit next to Personal Information.</string>
    <string name="q_verify">How long does verification take?</string>
    <string name="a_verify">Most accounts are reviewed within two working days. You will get a notification when it is done.</string>
    <string name="q_phone">Can I change my phone number?</string>
    <string name="a_phone">Your phone number is verified, so changing it needs a new verification. Contact support to start.</string>
    <string name="q_emergency">What should I do in an emergency?</string>
    <string name="a_emergency">Open Help &amp; Safety, then Emergency Assist, and call the emergency number. Move to a safe place first if you can.</string>
    <string name="q_report">How do I report unsafe behaviour?</string>
    <string name="a_report">Use Report a Safety Issue in Help &amp; Safety. Add as much detail as you can and our team will review it.</string>
    <string name="q_share">Can I share my trip with someone?</string>
    <string name="a_share">Yes. Open Help &amp; Safety and tap Share Live Trip to send a message to family or friends.</string>
