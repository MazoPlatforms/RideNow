    <string name="a_first">"Siga la ruta hasta el punto de recogida, toque Llegado, comience el viaje cuando el pasajero suba y complételo al dejarlo."</string>
    <string name="q_docs">"¿Qué documentos necesito?"</string>
    <string name="a_docs">"Licencia de conducir, matrícula del vehículo, certificado de seguro, certificado de prueba de emisiones y fotografías de su vehículo."</string>
    <string name="q_expiry">"¿Qué pasa si un documento caduca?"</string>
    <string name="a_expiry">"Cargue una nueva copia de los Documentos del vehículo antes de la fecha de vencimiento. Los documentos vencidos pueden impedirle conectarse."</string>
    <string name="q_change_vehicle">"¿Cómo cambio mi vehículo?"</string>
    <string name="a_change_vehicle">"Abra Detalles del vehículo, toque Actualizar detalles del vehículo y cargue nuevos documentos. Revisamos los cambios antes de que se apliquen."</string>
    <string name="q_withdraw">"¿Cómo retiro mis ganancias?"</string>
    <string name="a_withdraw">"Abra Pagos y transacciones, toque Retirar, ingrese un monto hasta su saldo y confirme. Los fondos van a su cuenta bancaria vinculada."</string>
    <string name="q_payout_late">"Mi pago no ha llegado"</string>
    <string name="a_payout_late">"Los pagos pueden demorar hasta tres días hábiles. Si es posterior, cree un ticket de soporte e incluya una captura de pantalla de sus ganancias."</string>
    <string name="q_cash">"¿Cómo se cuentan los viajes en efectivo?"</string>
    <string name="a_cash">"Cobras dinero en efectivo del pasajero. Se registra como Efectivo cobrado y no cambia su saldo retirable."</string>
    <string name="q_cancel">"¿Puedo cancelar un viaje?"</string>
    <string name="a_cancel">"Sí, antes de que comience el viaje. Las cancelaciones frecuentes pueden afectar su calificación, así que cancele solo cuando sea necesario."</string>
    <string name="q_nav">"La navegación no funciona"</string>
    <string name="a_nav">"Verifique que la ubicación esté permitida para RideNow Driver y que tenga una conexión de datos, luego intente Navegar nuevamente."</string>
    <string name="q_wrong_pin">"El pasador de recogida se ve mal"</string>
    <string name="a_wrong_pin">"Llame o envíe un mensaje al pasajero para confirmar dónde se encuentra e informe el problema después del viaje para que podamos mejorar el mapa."</string>
    <string name="q_edit_profile">"¿Cómo edito mi perfil?"</string>
    <string name="a_edit_profile">"Abra su perfil desde el avatar en la parte superior, luego toque Editar junto a Información personal."</string>
    <string name="q_verify">"¿Cuánto tiempo lleva la verificación?"</string>
    <string name="a_verify">"La mayoría de las cuentas se revisan dentro de dos días hábiles. Recibirás una notificación cuando esté listo."</string>
    <string name="q_phone">"¿Puedo cambiar mi número de teléfono?"</string>
    <string name="a_phone">"Su número de teléfono está verificado, por lo que para cambiarlo es necesario realizar una nueva verificación. Póngase en contacto con el soporte para comenzar."</string>
    <string name="q_emergency">"¿Qué debo hacer en caso de emergencia?"</string>
    <string name="a_emergency">"Abra Ayuda y seguridad, luego Asistencia de emergencia y llame al número de emergencia. Si puede, primero muévase a un lugar seguro."</string>
    <string name="q_report">"¿Cómo informo de un comportamiento inseguro?"</string>
    <string name="a_report">"Utilice Informar un problema de seguridad en Ayuda y seguridad. Agregue tantos detalles como pueda y nuestro equipo los revisará."</string>
    <string name="q_share">"¿Puedo compartir mi viaje con alguien?"</string>
    <string name="a_share">"Sí. Abra Ayuda y seguridad y toque Compartir viaje en vivo para enviar un mensaje a familiares o amigos."</string>
